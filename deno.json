{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "types": ["npm:@types/node@22.15.17"],
    "lib": ["deno.window", "esnext"]
  },
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "test": "deno run -A scripts/test.ts",
    "test:unit": "deno test -A scripts/tests/run.ts",
    "test:assets:pkl": "deno test -A scripts/tests/assets-pkl.ts",
    "typecheck": "deno check scripts/*.ts scripts/tests/*.ts && deno run -A npm:typescript@5.8.2/tsc --noEmit -p tsconfig.json",
    "objects:eval": "deno run -A scripts/evaluate-objects.ts",
    "assets:check": "deno run -A scripts/assets.ts check",
    "settings:check": "deno run -A scripts/map-settings.ts",
    "test:settings:pkl": "deno test -A scripts/tests/map-settings-pkl.ts",
    "assets:sync": "deno run -A scripts/assets.ts sync",
    "schema:gen": "deno run -A scripts/generate-pkl-schema.ts",
    "bases:gen": "deno run -A scripts/generate-pkl-bases.ts && deno task schema:gen",
    "build:defs": "deno run -A scripts/dev.ts",
    "dev": "deno run -A scripts/watch.ts",
    "lint": "deno lint && deno task lint:json",
    "lint:json": "deno run -A scripts/validate-json.ts"
  },
  "lint": {
    "plugins": ["./scripts/lint/wcraft-rules.ts"],
    "exclude": [
      "node_modules",
      "dist",
      "maps",
      "objects/bases.pkl",
      "objects/schema/generated",
      "src/generated",
      "src/war3map.d.ts"
    ],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "no-eval",
        "no-throw-literal",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn"
      ]
    }
  },
  "fmt": {
    "exclude": [
      "node_modules",
      "dist",
      "maps",
      "objects/bases.pkl",
      "objects/schema/generated",
      "src/generated"
    ]
  },
  "lock": {
    "frozen": true
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@^1.1.5"
  }
}
